{
    "name": "ugarit/surveyor",
    "description": "Static analysis tool for Ugarit applications.",
    "keywords": [
        "ugarit"
    ],
    "homepage": "https://github.com/ugarit/surveyor",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/ugarit/surveyor/issues",
        "source": "https://github.com/ugarit/surveyor"
    },
    "authors": [
        {
            "name": "Muath R Abu Ouda",
            "email": "muathrabuouda@hotmail.com",
            "role": "Vision Leader of Ugarit"
        },
        {
            "name": "Taylor Otwell",
            "email": "taylor@laravel.com",
            "role": "Original Creator & Primary Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "heritage/auth": "^1.00.00",
        "heritage/container": "^1.00.00",
        "heritage/contracts": "^1.00.00",
        "heritage/database": "^1.00.00",
        "heritage/filesystem": "^1.00.00",
        "heritage/http": "^1.00.00",
        "heritage/support": "^1.00.00",
        "heritage/validation": "^1.00.00",
        "nikic/php-parser": "^5.4",
        "phpstan/phpdoc-parser": "^2.1"
    },
    "require-dev": {
        "inertiajs/inertia-ugarit": "^3.1",
        "ugarit/pint": "^1.00.00",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Ugarit\\Surveyor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.x-dev"
        },
        "ugarit": {
            "providers": [
                "Ugarit\\Surveyor\\SurveyorServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "@php vendor/bin/pint --ansi",
            "@php vendor/bin/phpstan analyse --verbose --ansi"
        ],
        "test": "@php vendor/bin/pest --parallel",
        "test-unit": "@php vendor/bin/pest tests/Unit --parallel",
        "test-feature": "@php vendor/bin/pest tests/Feature --parallel",
        "test-coverage": "@php vendor/bin/pest --coverage",
        "test-coverage-html": "@php vendor/bin/pest --coverage-html coverage"
    },
    "version": "1.00.00"
}
